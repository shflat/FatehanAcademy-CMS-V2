# ===================================================
# Dockerfile for GhabeAks24 Studio (سامانه قاب عکس ۲۴)
# Full-Stack Vite + Express Server Application
# ===================================================

# ---------------------------------------------------
# Stage 1: Build stage
# ---------------------------------------------------
FROM node:22-alpine AS builder

WORKDIR /app

ENV NPM_CONFIG_LEGACY_PEER_DEPS=true

# Copy package files for dependency caching
COPY package*.json ./

# Install all dependencies (including devDependencies for building)
RUN npm install --legacy-peer-deps

# Copy the rest of the source code
COPY . .

# Build Vite frontend & compile server.ts to server.js via project build script
RUN npm run build

# ---------------------------------------------------
# Stage 2: Production runner stage
# ---------------------------------------------------
FROM node:22-alpine AS runner

WORKDIR /app

ENV NODE_ENV=production
ENV NPM_CONFIG_LEGACY_PEER_DEPS=true

# Copy dependency manifests
COPY package*.json ./

# Install only production dependencies
RUN npm install --omit=dev --legacy-peer-deps && npm cache clean --force

# Copy built distribution files and compiled backend server from builder stage
COPY --from=builder /app/dist ./dist
COPY --from=builder /app/public ./public
COPY --from=builder /app/server.js ./server.js
COPY --from=builder /app/vite.config.* ./

# Ensure uploads directory exists
RUN mkdir -p /app/uploads

# Expose default application port
EXPOSE 3000

# Run the full-stack production Express server
CMD ["node", "server.js"]
