# PostgreSQL Database Connection (Method 2 - Docker Compose PostgreSQL 16)
DATABASE_URL="postgresql://skill98:CHANGE_ME_PASSWORD@skill98-postgres:5432/skill98_db"
POSTGRES_USER="skill98"
POSTGRES_PASSWORD="CHANGE_ME_PASSWORD"
POSTGRES_DB="skill98_db"

# Security, Hashing & Session Secrets (Leave empty in dev to auto-generate in data/.runtime-secrets.json)
OTP_HMAC_SECRET=""
PERMISSION_HASH_SECRET=""

# Bootstrapped Super Admin Credentials (Set in .env — never hardcode in source)
ADMIN_PHONE=""
ADMIN_EMAIL=""
ADMIN_MASTER_CODE=""
ADMIN_MASTER_CODE_HASH=""
VITE_BOOTSTRAPPED_ADMIN_EMAIL=""

# Gemini AI API (Optional - Server-Side SEO Assistant)
GEMINI_API_KEY=""

# Public Site URL & Traefik Domain (Optional: auto-detected from incoming Host/Protocol if left empty)
APP_DOMAIN=""
APP_URL=""

# Optional SMS & Payment Env Overrides (Can also be configured in Admin Panel)
KAVENEGAR_API_KEY=""
ZARINPAL_MERCHANT_ID=""

# Optional Daily Backup SMTP (Can also be configured in Admin Panel — use placeholders only)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-email@example.com"
SMTP_PASS="CHANGE_ME_APP_PASSWORD"
